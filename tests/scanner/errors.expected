   1 LET           'let'
   1 IDENTIFIER    'ok'
   1 EQUAL         '='
   1 NUMBER        '1'
   1 SEMICOLON     ';'
   2 LET           'let'
   2 IDENTIFIER    'bad'
   2 EQUAL         '='
   2 ERROR         'Unexpected character.'
   2 SEMICOLON     ';'
   3 LET           'let'
   3 IDENTIFIER    's'
   3 EQUAL         '='
   3 ERROR         'Unterminated string.'
   4 EOF           ''
