   1 LEFT_PAREN    '('
   1 RIGHT_PAREN   ')'
   1 LEFT_BRACE    '{'
   1 RIGHT_BRACE   '}'
   1 LEFT_BRACKET  '['
   1 RIGHT_BRACKET ']'
   1 COMMA         ','
   1 DOT           '.'
   1 MINUS         '-'
   1 PLUS          '+'
   1 SEMICOLON     ';'
   1 SLASH         '/'
   1 STAR          '*'
   1 PERCENT       '%'
   2 EOF           ''
